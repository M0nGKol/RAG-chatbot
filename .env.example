# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token

# --- Google AI Studio / Gemini ---
GOOGLE_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Neo4j (Aura Free) ---
# Copy these straight from the credentials .txt Aura downloads when you
# create the instance (Aura Console -> Instances -> Create instance).
# NOTE: on newer Aura instances the username and database are your
# instance ID (e.g. "37072332"), NOT the literal word "neo4j" -- use
# exactly what's in that file, don't assume the defaults below.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=paste-the-generated-password-here
NEO4J_DATABASE=neo4j

# --- MCP server (how the orchestrator launches the Neo4j MCP server as a subprocess) ---
# Official server: pip install neo4j-mcp-server
MCP_SERVER_COMMAND=neo4j-mcp-server
# Alternative (Neo4j Labs, Cypher-focused): pip install mcp-neo4j-cypher
# MCP_SERVER_COMMAND=mcp-neo4j-cypher

# --- Dedup / incremental learning thresholds (cosine similarity, 0-1) ---
# Used two ways now (see ingestion/dedup.py):
#  - metadata-driven files (have a .json sidecar): only DUPLICATE_THRESHOLD
#    matters -- score >= this vs other chunks in the SAME concept -> skip.
#  - files with no sidecar (topic-discovery fallback): both thresholds are
#    used to guess SKIP / EXTEND / NEW against the whole graph.
DUPLICATE_THRESHOLD=0.97
EXTEND_THRESHOLD=0.90
TOP_K_SIMILAR=3
